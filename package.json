{
  "name": "circle",
  "version": "1.0.0",
  "description": "Circle - A cross-platform OLED screensaver with bouncing content display featuring clock, stock prices, and system info to prevent burn-in",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.circle.app",
    "productName": "Circle",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "files": [
      "src/**/*",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ]
  },
  "keywords": [
    "oled",
    "screensaver",
    "electron",
    "burn-in",
    "clock",
    "stocks",
    "system-monitor"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "desktop-idle": "^1.3.0",
    "electron-store": "^8.2.0",
    "systeminformation": "^5.30.5"
  }
}
