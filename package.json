{
  "name": "oled-saver",
  "version": "1.0.0",
  "description": "A cross-platform OLED screensaver with bouncing content display featuring clock, stock prices, and system info to prevent burn-in",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "oled",
    "screensaver",
    "electron",
    "burn-in",
    "clock",
    "stocks",
    "system-monitor"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "desktop-idle": "^1.3.0",
    "electron-store": "^8.2.0",
    "systeminformation": "^5.30.5"
  }
}
